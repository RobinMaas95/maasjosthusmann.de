    "playwright": "^1.60.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "marked-highlight": "^2.2.4"
  }
}
